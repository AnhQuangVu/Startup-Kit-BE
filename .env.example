# Database Configuration
MYSQL_DATABASE=startupkit
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_PORT=3307

# Application Configuration
APP_PORT=8003
# For Docker: use 'db' as host, for local: use 'localhost'
DATABASE_URL=mysql+mysqlconnector://your_mysql_user:your_mysql_password@db:3306/startupkit

# Security Configuration
SECRET_KEY=your_secret_key_here_generate_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI Configuration
API_KEY=your_openai_api_key_here
BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# SerpAPI Configuration
SERPAPI_API_KEY=your_serpapi_key_here
VECTOR_DB_PATH=data/vector_db
DOCUMENTS_PATH=data/documents
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
TOP_K_RESULTS=10